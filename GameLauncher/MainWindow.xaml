<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher" 
        Height="800" 
        Width="1280"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="pack://application:,,,/GameLauncher;component/Assets/Fonts/#Inter"
        Icon="pack://application:,,,/GameLauncher;component/Assets/App_icon.ico">


    <Window.Resources>
        <!-- Main Content Style -->
        <Style x:Key="MainContentStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <LinearGradientBrush x:Key="MainContentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000817" Offset="0.0" />
            <GradientStop Color="#1B0300" Offset="0.46"/>
            <GradientStop Color="#301D00" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Button Hover Effect -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4AA24D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="25"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D8B40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" CornerRadius="10" BorderThickness="0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCC"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                ClipToBounds="True"/>

                            <Border x:Name="PART_Indicator" 
                                HorizontalAlignment="Left" 
                                Background="{TemplateBinding Foreground}" 
                                CornerRadius="6" 
                                ClipToBounds="True"/>
                            
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop x:Name="S1" Color="Transparent"  Offset="-0.3"/>
                                        <GradientStop x:Name="S2" Color="#55FFFFFF"    Offset="-0.1"/>
                                        <GradientStop x:Name="S3" Color="Transparent"  Offset="0.1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="S1"
                                    Storyboard.TargetProperty="Offset"
                                    From="-0.3" To="1.2" Duration="0:0:1.5"/>
                                        <DoubleAnimation Storyboard.TargetName="S2"
                                    Storyboard.TargetProperty="Offset"
                                    From="-0.1" To="1.4" Duration="0:0:1.5"/>
                                        <DoubleAnimation Storyboard.TargetName="S3"
                                    Storyboard.TargetProperty="Offset"
                                    From="0.1"  To="1.6" Duration="0:0:1.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Progress Bar Brush -->
        <LinearGradientBrush x:Key="FigmaGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0049FF" Offset="0.0" />
            <GradientStop Color="#FF1400" Offset="0.67"/>
            <GradientStop Color="#FF8900" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="OfflineGrayBrush" Color="#555555" />
        <!-- Refresh Button Style -->
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CacheMode" Value="BitmapCache"/>
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#E74C3C" Duration="0:0:0.1"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                            To="White" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.1"/>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                            To="#AAAAAA" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                       
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Viewbox Stretch="Uniform">

        <Border Cursor="Arrow" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="15" BorderBrush="#3A3A3A" BorderThickness="2" Width="1080" Height="640">
            <!-- Background -->
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/GameLauncher;component/Assets/background.png" Stretch="UniformToFill" />
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="20" Opacity="0.8" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid Cursor="Hand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button  
                           Style="{StaticResource CloseButton}"
                           Click="BottomButton_Click" Margin="0 0 20 0">
                            <Image Source="pack://application:,,,/GameLauncher;component/Assets/bottom.png"
                                   Width="24" Height="24" 
                                   />
                        </Button>

                        <Button
                           Style="{StaticResource CloseButton}"
                           Click="CloseButton_Click" Margin="0 0 20 0">

                            <Image Source="pack://application:,,,/GameLauncher;component/Assets/close.png"
                                   Width="24" Height="24"
                                    />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Border Padding="0" Background="{StaticResource MainContentBrush}" 
                            CornerRadius="20" Width="800"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MainContentStyle}">

                            <Image Source="pack://application:,,,/GameLauncher;component/Assets/logo.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center" Margin="0 80 0 120"
                               RenderOptions.BitmapScalingMode="HighQuality" Width="380"
                           />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0 0 0 20">

                                <!-- Status Text -->
                                <TextBlock x:Name="StatusText" 
                                   Text="Başlatılıyor..." 
                                   Foreground="White" 
                                   FontSize="28"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" 
                                   FontWeight="Medium"/>


                                <Button x:Name="RetryButton" Style="{StaticResource ImageButtonStyle}"
                                    Visibility="Collapsed" Margin="15 0 0 0"
                                    Click="RetryButton_Click" ToolTip="Tekrar Dene">

                                    <Image Source="pack://application:,,,/GameLauncher;component/Assets/retry.png"
                                       Width="24" Height="24"
                                       />
                                </Button>

                            </StackPanel>

                            <!-- Progress Bar -->
                            <Grid Width="550" Margin="0,0,0,0">
                                <ProgressBar x:Name="DownloadProgress" 
                                     Value="0" 
                                     Maximum="100" 
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     Foreground="{StaticResource FigmaGradientBrush}"/>
                            </Grid>

                            <!-- Percentage & Speed -->
                            <Grid Width="550" Margin="0,0,0,30">
                                <TextBlock x:Name="PercentageText" 
                                   Text="0%" 
                                   Foreground="#888888" 
                                   HorizontalAlignment="Left" 
                                   FontSize="12"/>

                                <TextBlock x:Name="SpeedText" 
                                   Text="0 MB/s" 
                                   Foreground="#888888" 
                                   HorizontalAlignment="Right" 
                                   FontSize="12"/>
                            </Grid>

                            <!-- Play/Launch Button -->
                            <Button x:Name="PlayButton" 
                                Margin="0 0 0 20"
                                Content="BAŞLAT" 
                                Width="220" 
                                Height="55" 
                                Style="{StaticResource ModernButton}"
                                Click="PlayButton_Click" 
                                Visibility="Collapsed"/>

                            <Grid Width="793" Margin="10,30,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="VersionText" Grid.Column="0"
                                   Text="v1.0.0" 
                                   Foreground="#CECDCD" 
                                   VerticalAlignment="Bottom" 
                                   HorizontalAlignment="Left"
                                   FontSize="18" FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="1"
                                   Text="Powered by Cloudflare R2" 
                                   Foreground="#CECDCD" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Right" 
                                   FontSize="18" FontWeight="SemiBold"/>

                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>